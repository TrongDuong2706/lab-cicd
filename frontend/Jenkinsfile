pipeline {
    agent any

    environment {
        AWS_REGION      = credentials('AWS_REGION')
        ECR_REPO        = credentials('ECR_REPO')
        ECS_CLUSTER     = credentials('ECS_CLUSTER')
        ECS_SERVICE     = credentials('ECS_SERVICE')
        IMAGE_TAG       = credentials('IMAGE_TAG')
        // Thêm các biến môi trường cho SonarQube
        SONAR_CLOUD_ORG = "fpt-lab" // <-- THAY THẾ BẰNG ORGANIZATION KEY CỦA BẠN
        SONAR_PROJECT_KEY = "fpt-cicd-lab"   // <-- THAY THẾ BẰNG PROJECT KEY CỦA BẠN
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "Checking out source code..."
                checkout scm
            }
        }

        // ================= STAGE MỚI: SONARQUBE ANALYSIS =================
        stage('2. SonarQube Analysis') {
            steps {
                dir('frontend') { // Di chuyển vào thư mục chứa source code cần quét
                    // Sử dụng tool SonarScanner đã cấu hình trong Global Tool Configuration
                    def scannerHome = tool 'SonarScanner-Version' 

                    withSonarQubeEnv('SonarQubeCloud') { // Tên đã đặt ở bước cấu hình Jenkins
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.organization=${SONAR_CLOUD_ORG} \
                                -Dsonar.sources=. \
                                -Dsonar.host.url=https://sonarcloud.io
                        """
                    }
                }
            }
        }
        
        // --- Nâng cao: Chờ kết quả Quality Gate ---
        // stage('2. SonarQube Analysis & Quality Gate') {
        //     steps {
        //         dir('frontend') {
        //             withSonarQubeEnv('SonarQubeCloud') {
        //                 sh "sonar-scanner -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.organization=${SONAR_CLOUD_ORG} -Dsonar.sources=. -Dsonar.host.url=https://sonarcloud.io"
        //             }
        //         }
        //         // Tạm dừng pipeline và chờ kết quả phân tích từ SonarCloud
        //         // Pipeline sẽ FAILED nếu Quality Gate không đạt
        //         timeout(time: 15, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }
        // =====================================================================

        stage('3. Build Docker Image') { // Đánh số lại
            steps {
                dir('frontend') {
                    echo "Building Docker image..."
                    sh """
                        docker build -t $ECR_REPO:$IMAGE_TAG .
                    """
                }
            }
        }

        stage('4. Trivy Scan Image') { // Đánh số lại
            steps {
                dir('frontend') {
                    echo "Scanning Docker image with Trivy..."
                    sh """
                        docker run --rm \
                          -v \$(pwd):/workspace \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          aquasec/trivy image \
                            --format template \
                            --template "@contrib/html.tpl" \
                            --output /workspace/trivy-report.html \
                            $ECR_REPO:$IMAGE_TAG
                    """
                }
            }
        }

        stage('5. Authenticate ECR') { // Đánh số lại
            steps {
                echo "Authenticating to ECR..."
                sh """
                    aws ecr get-login-password --region $AWS_REGION | \
                    docker login --username AWS --password-stdin $ECR_REPO
                """
            }
        }

        stage('6. Push Docker Image to ECR') { // Đánh số lại
            steps {
                echo "Pushing Docker image to ECR..."
                sh """
                    docker push $ECR_REPO:$IMAGE_TAG
                """
            }
        }

        stage('7. Update ECS Service') { // Đánh số lại
            steps {
                echo "Updating ECS service to use new image..."
                sh """
                    aws ecs update-service \
                        --cluster $ECS_CLUSTER \
                        --service $ECS_SERVICE \
                        --force-new-deployment \
                        --region $AWS_REGION
                """
            }
        }
    }

    post {
        always {
            echo "Frontend pipeline completed."
            archiveArtifacts artifacts: 'frontend/trivy-report.html', fingerprint: true
        }
        success {
            echo "Frontend successfully deployed to ECS!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}