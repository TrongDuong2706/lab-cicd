pipeline {
    agent any

    environment {
        AWS_REGION      = credentials('AWS_REGION')
        ECR_REPO        = credentials('ECR_REPO_BE')
        ECS_CLUSTER     = credentials('ECS_CLUSTER')
        ECS_SERVICE     = credentials('ECS_SERVICE_BE')
        IMAGE_VERSION   = 'latest'
        SONAR_CLOUD_ORG = credentials('SONAR_CLOUD_ORG')
        SONAR_PROJECT_KEY_BE = credentials('SONAR_PROJECT_KEY_BE')
        // Ghi lại ID của credential chứa token SonarCloud của bạn
        SONAR_CREDENTIALS_ID = 'sonar-token' 
    }

    stages {
        stage('Build and Deploy Backend') {
            when {
                expression {
                    return sh(returnStatus: true, script: "git diff --name-only HEAD~1 HEAD | grep -q 'backend/'") == 0
                }
            }
            stages {
                stage('1. Checkout Code') {
                    steps {
                        echo "Checking out source code..."
                        checkout scm
                    }
                }

                // ================= STAGE 2 ĐÃ ĐƯỢC THAY THẾ HOÀN TOÀN =================
                stage('2. SonarQube Analysis') {
                    steps {
                        dir('backend') {
                            // Sử dụng withCredentials để lấy token một cách an toàn và đáng tin cậy
                            withCredentials([string(credentialsId: SONAR_CREDENTIALS_ID, variable: 'SONAR_TOKEN_VALUE')]) {
                                sh """
                                    docker run --rm \
                                        -e SONAR_TOKEN=${SONAR_TOKEN_VALUE} \
                                        -v "\$(pwd):/usr/src" \
                                        -v "\$HOME/.nuget/packages:/root/.nuget/packages" \
                                        -w /usr/src \
                                        sonarsource/sonar-scanner-dotnet:latest \
                                        sh -c ' \
                                            dotnet sonarscanner begin \
                                                /k:"${SONAR_PROJECT_KEY_BE}" \
                                                /o:"${SONAR_CLOUD_ORG}" \
                                                /d:sonar.host.url="https://sonarcloud.io" \
                                                /d:sonar.exclusions="**/*.html,**/obj/**,**/bin/**" \
                                            && dotnet build App.csproj \
                                            && dotnet sonarscanner end \
                                        '
                                """
                            }
                        }
                    }
                }

                stage('3. Build Docker Image') {
                    steps {
                        dir('backend') {
                            echo "Building Docker image..."
                            sh "docker build -t $ECR_REPO:$IMAGE_VERSION ."
                        }
                    }
                }

                stage('4. Trivy Scan Image') {
                    steps {
                        dir('backend') {
                            echo "Scanning Docker image with Trivy..."
                            sh """
                                docker run --rm \
                                  -v \$(pwd):/workspace \
                                  -v /var/run/docker.sock:/var/run/docker.sock \
                                  aquasec/trivy image \
                                    --format template \
                                    --template "@contrib/html.tpl" \
                                    --output /workspace/trivy-report.html \
                                    $ECR_REPO:$IMAGE_VERSION
                            """
                        }
                    }
                }

                stage('5. Authenticate ECR') {
                    steps {
                        echo "Authenticating to ECR..."
                        sh """
                            aws ecr get-login-password --region $AWS_REGION | \
                            docker login --username AWS --password-stdin $ECR_REPO
                        """
                    }
                }

                stage('6. Push Docker Image to ECR') {
                    steps {
                        dir('backend') {
                            echo "Pushing Docker image to ECR..."
                            sh "docker push $ECR_REPO:$IMAGE_VERSION"
                        }
                    }
                }

                stage('7. Update ECS Service') {
                    steps {
                        echo "Updating ECS service to use new image..."
                        sh """
                            aws ecs update-service \
                                --cluster $ECS_CLUSTER \
                                --service $ECS_SERVICE \
                                --force-new-deployment \
                                --region $AWS_REGION
                        """
                    }
                }
            }
        } 
    }

    post {
        always {
            echo "Backend pipeline completed."
            archiveArtifacts artifacts: 'backend/trivy-report.html', fingerprint: true
        }
        success {
            echo "Backend successfully deployed to ECS!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}