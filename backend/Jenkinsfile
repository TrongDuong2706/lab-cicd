pipeline {
    agent any

    environment {
        AWS_REGION  = credentials('AWS_REGION')
        ECR_REPO    = credentials('ECR_REPO_BE')
        ECS_CLUSTER = credentials('ECS_CLUSTER')
        ECS_SERVICE = credentials('ECS_SERVICE_BE')
        IMAGE_TAG   = credentials('IMAGE_TAG')
        SONAR_CLOUD_ORG = credentials('SONAR_CLOUD_ORG')
        SONAR_PROJECT_KEY = credentials('SONAR_PROJECT_KEY')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "Checking out source code..."
                checkout scm
            }
        }
        stage('2. SonarQube Analysis & Quality Gate Check') {
            steps {
                dir('backend') {
                    script {
                        def scannerHome = tool 'SonarScanner-Version' 

                        withSonarQubeEnv('SonarQubeCloud') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                    -Dsonar.organization=${SONAR_CLOUD_ORG} \
                                    -Dsonar.sources=. \
                                    -Dsonar.host.url=https://sonarcloud.io 
                            """
                        }
                        // timeout(time: 15, unit: 'MINUTES') { 
                        //     def qg = waitForQualityGate abortPipeline: true
                            
                        //     if (qg.status != 'OK') {
                        //         error "Pipeline stopped due to SonarQube Quality Gate failure: ${qg.status}"
                        //     } else {
                        //         echo "SonarQube Quality Gate passed!"
                        //     }
                        // }
                    }
                }
            }
        }

        stage('3. Build Docker Image') {
            steps {
                dir('backend') {
                    echo "Building Docker image..."
                    sh """
                        docker build -t $ECR_REPO:$IMAGE_TAG .
                    """
                }
            }
        }

        stage('4. Trivy Scan Image') {
            steps {
                dir('backend') {
                    echo "Scanning Docker image with Trivy..."
                    sh """
                        docker run --rm \
                          -v \$(pwd):/workspace \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          aquasec/trivy image \
                            --format template \
                            --template "@contrib/html.tpl" \
                            --output /workspace/trivy-report.html \
                            $ECR_REPO:$IMAGE_TAG
                    """
                }
            }
        }

        stage('5. Authenticate ECR') {
            steps {
                echo "Authenticating to ECR..."
                sh """
                    aws ecr get-login-password --region $AWS_REGION | \
                    docker login --username AWS --password-stdin $ECR_REPO
                """
            }
        }

        stage('6. Push Docker Image to ECR') {
            steps {
                echo "Pushing Docker image to ECR..."
                sh """
                    docker push $ECR_REPO:$IMAGE_TAG
                """
            }
        }

        stage('7. Update ECS Service') {
            steps {
                echo "Updating ECS service to use new image..."
                sh """
                    aws ecs update-service \
                        --cluster $ECS_CLUSTER \
                        --service $ECS_SERVICE \
                        --force-new-deployment \
                        --region $AWS_REGION
                """
            }
        }
    }

    post {
        always {
            echo "Backend pipeline completed."
            archiveArtifacts artifacts: 'backend/trivy-report.html', fingerprint: true
        }
        success {
            echo "Backend successfully deployed to ECS!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}