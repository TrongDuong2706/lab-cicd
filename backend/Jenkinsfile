pipeline {
    agent any

    environment {
        AWS_REGION  = 'ap-southeast-1'
        ECR_REPO    = '980921740481.dkr.ecr.ap-southeast-1.amazonaws.com/backend'
        ECS_CLUSTER = credentials('ECS_CLUSTER')
        ECS_SERVICE = 'backend-service'
        IMAGE_TAG   = credentials('IMAGE_TAG')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "Checking out source code..."
                checkout scm
            }
        }

        stage('2. Build Docker Image') {
            steps {
                dir('backend') {
                    echo "Building Docker image..."
                    sh """
                        docker build -t $ECR_REPO:$IMAGE_TAG .
                    """
                }
            }
        }

        stage('3. Authenticate ECR') {
            steps {
                echo "Authenticating to ECR..."
                sh """
                    aws ecr get-login-password --region $AWS_REGION | \
                    docker login --username AWS --password-stdin $ECR_REPO
                """
            }
        }

        stage('4. Push Docker Image to ECR') {
            steps {
                echo "Pushing Docker image to ECR..."
                sh """
                    docker push $ECR_REPO:$IMAGE_TAG
                """
            }
        }

        stage('5. Update ECS Service') {
            steps {
                echo "Updating ECS service to use new image..."
                sh """
                    aws ecs update-service \
                        --cluster $ECS_CLUSTER \
                        --service $ECS_SERVICE \
                        --force-new-deployment \
                        --region $AWS_REGION
                """
            }
        }
    }

    post {
        always {
            echo "Frontend pipeline completed."
        }
        success {
            echo "Frontend successfully deployed to ECS!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
